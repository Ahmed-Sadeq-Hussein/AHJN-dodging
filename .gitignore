# machine-specific paths -- see .env.example for the template
.env
.env.*
!.env.example

__pycache__/
*.pyc

# generated audio and metrics live outside this repo (RESULTS_ROOT), but
# ignore them here too in case a script is ever pointed at a local folder
/out/
*.jpg
*.jpeg
*.mp3
*.mp4
*.wav

# evaluation results belong under RESULTS_ROOT. eval_all15.py appends a .jsonl
# beside its output as it goes, and a bare --out used to land it here; one got
# committed that way. graphs/summary.json is the exception -- it is a small
# derived record of the figures and is kept deliberately.
*.jsonl

# model checkpoints and PGD datasets live in RESULTS_ROOT; never commit them
*.pt
*.pth
*.onnx
*.safetensors
