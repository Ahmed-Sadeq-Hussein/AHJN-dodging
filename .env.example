# Copy this file to .env (same folder) and adjust the four paths below for
# your machine. env_config.py loads .env automatically -- nothing else in
# this repo hardcodes a path.
#
# A real environment variable of the same name always wins over .env, so
# these can also be exported in your shell / conda env activation instead.

# clovaai/aasist, RawGAT-ST, asvspoof2021-baselines + their pretrained weights
VOICE_DETECTION_ROOT=D:\Voice detection

# CosyVoice2 repo + models\CosyVoice2-0.5B weights
VOICE_CLONING_ROOT=D:\Voice cloning

# one subfolder per voice, each with reference.wav (+ optional reference.txt)
VOICE_DATA_ROOT=D:\voice data\Voices

# output root -- generators\ and discriminator\ are created under here
RESULTS_ROOT=D:\results and benchmarks

# --- optional overrides; uncomment only if you want these somewhere else
# than the defaults derived from RESULTS_ROOT / VOICE_CLONING_ROOT above ---
#GENERATORS_DIR=D:\results and benchmarks\generators
#DISCRIMINATOR_DIR=D:\results and benchmarks\discriminator
#METRICS_DIR=D:\results and benchmarks\generators\metrics
#CAMPPLUS_ONNX_PATH=D:\Voice cloning\models\CosyVoice2-0.5B\campplus.onnx
